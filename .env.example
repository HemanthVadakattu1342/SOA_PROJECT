# =============================================================
# SpendWise - Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# =============================================================

# Database credentials for manually starting backend services.
# start-all.bat prompts securely instead of reading this file.
DB_USERNAME=root
DB_PASSWORD=replace-with-your-MySQL-root-password

# JWT Secret - must be the SAME value across all services
# Use a long random string (at least 32 characters)
JWT_SECRET=SpendWise-Super-Secret-Key-That-Is-At-Least-256-Bits-Long-For-Security

# File upload directory for expense receipts
FILE_UPLOAD_DIR=./uploads/receipts
